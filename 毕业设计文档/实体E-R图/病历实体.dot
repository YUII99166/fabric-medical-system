graph ER {
    // 图形设置
    rankdir=TB;
    splines=true;
    nodesep=1.2;
    ranksep=1.2;
    bgcolor="#FFFFFF";
    
    node [fontname="SimHei", fontsize=12];
    edge [fontname="SimHei", fontsize=10, color="#666666"];

    // 病历实体（矩形，绿色）
    Prescription [
        shape=box, 
        label="病历\nPrescription", 
        style=filled, 
        fillcolor="#e8f5e8", 
        color="#4caf50",
        width=2.0, 
        height=1.2,
        fontsize=16,
        fontcolor="#4caf50"
    ];

    // 主键属性（椭圆，红色边框，下划线）
    prescription_id [
        shape=ellipse, 
        label=<<u><b>病历ID</b></u>>, 
        style=filled, 
        fillcolor="#ffebee",
        color="#d32f2f",
        penwidth=3
    ];
    
    // 唯一键属性（椭圆，橙色边框，下划线）
    prescription_no [
        shape=ellipse, 
        label=<<u>病历编号</u>>, 
        style=filled, 
        fillcolor="#e3f2fd",
        color="#f57c00",
        penwidth=3
    ];
    
    // 外键属性（蓝色）
    patient_id [
        shape=ellipse, 
        label="患者ID", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    doctor_id [
        shape=ellipse, 
        label="医生ID", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    // 患者相关属性（浅蓝色）
    patient_name [
        shape=ellipse, 
        label="患者姓名", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    // 诊疗核心属性（浅绿色）
    chief_complaint [
        shape=ellipse, 
        label="主诉", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    present_illness [
        shape=ellipse, 
        label="现病史", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    physical_exam [
        shape=ellipse, 
        label="体格检查", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    diagnosis [
        shape=ellipse, 
        label="诊断结果", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    medical_advice [
        shape=ellipse, 
        label="医嘱", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    // 医生相关属性（浅紫色）
    doctor_name [
        shape=ellipse, 
        label="医生姓名", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    // 医院组织属性（浅橙色）
    hospital_id [
        shape=ellipse, 
        label="医院ID", 
        style=filled, 
        fillcolor="#fff3e0",
        color="#ff9800"
    ];
    
    hospital_name [
        shape=ellipse, 
        label="医院名称", 
        style=filled, 
        fillcolor="#fff3e0",
        color="#ff9800"
    ];
    
    organization_id [
        shape=ellipse, 
        label="组织MSPID", 
        style=filled, 
        fillcolor="#fff3e0",
        color="#ff9800"
    ];
    
    // 系统属性（浅蓝色）
    created_at [
        shape=ellipse, 
        label="创建时间", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    tx_id [
        shape=ellipse, 
        label="交易ID", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    // 多值属性（双椭圆，特殊颜色）
    drug_list [
        shape=ellipse, 
        label="药品列表", 
        style=filled, 
        fillcolor="#fce4ec",
        color="#e91e63",
        peripheries=2
    ];
    
    authorized_orgs [
        shape=ellipse, 
        label="授权组织", 
        style=filled, 
        fillcolor="#fce4ec",
        color="#e91e63",
        peripheries=2
    ];

    // 连接实体和属性
    // 主键连接（粗线）
    Prescription -- prescription_id [penwidth=3, color="#d32f2f"];
    
    // 唯一键连接（粗线）
    Prescription -- prescription_no [penwidth=3, color="#f57c00"];
    
    // 普通属性连接
    Prescription -- patient_id;
    Prescription -- patient_name;
    Prescription -- chief_complaint;
    Prescription -- present_illness;
    Prescription -- physical_exam;
    Prescription -- diagnosis;
    Prescription -- medical_advice;
    Prescription -- doctor_id;
    Prescription -- doctor_name;
    Prescription -- hospital_id;
    Prescription -- hospital_name;
    Prescription -- organization_id;
    Prescription -- created_at;
    Prescription -- tx_id;
    Prescription -- drug_list;
    Prescription -- authorized_orgs;
    
    // 添加注释
    label=<<br/><font point-size="14"><b>病历实体 E-R 图</b></font><br/>
    <font point-size="12">医疗信息管理系统 - 病历实体属性关系图</font><br/>
    <font point-size="10">包含18个属性：1个主键，1个唯一键，14个普通属性，2个多值属性</font>>;
    labelloc="t";
    fontname="SimHei";
}
