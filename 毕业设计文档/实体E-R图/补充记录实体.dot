graph ER {
    // 图形设置
    rankdir=TB;
    splines=true;
    nodesep=1.2;
    ranksep=1.2;
    bgcolor="#FFFFFF";
    
    node [fontname="SimHei", fontsize=12];
    edge [fontname="SimHei", fontsize=10, color="#666666"];

    // 补充记录实体（双线矩形，紫色 - 弱实体）
    SupplementRecord [
        shape=box, 
        label="补充记录\nSupplementRecord", 
        style=filled, 
        fillcolor="#f3e5f5", 
        color="#9c27b0",
        width=2.2, 
        height=1.2,
        fontsize=16,
        fontcolor="#9c27b0",
        peripheries=2
    ];

    // 部分主键属性（椭圆，红色边框，下划线）
    supplement_id [
        shape=ellipse, 
        label=<<u><b>补充记录ID</b></u>>, 
        style=filled, 
        fillcolor="#ffebee",
        color="#d32f2f",
        penwidth=3
    ];
    
    // 外键属性（椭圆，红色边框，下划线）- 来自强实体的主键，构成复合主键
    prescription_id [
        shape=ellipse, 
        label=<<u><b>病历ID</b></u>>, 
        style=filled, 
        fillcolor="#ffebee",
        color="#d32f2f",
        penwidth=3
    ];
    
    // 外键属性（蓝色）
    doctor_id [
        shape=ellipse, 
        label="医生ID", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    // 记录核心属性（浅紫色）
    record_type [
        shape=ellipse, 
        label="记录类型", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    content [
        shape=ellipse, 
        label="补充内容", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    // 医生信息属性（浅蓝色）
    doctor_name [
        shape=ellipse, 
        label="医生姓名", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    // 系统属性（浅绿色）
    created_at [
        shape=ellipse, 
        label="创建时间", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    tx_id [
        shape=ellipse, 
        label="交易ID", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];

    // 连接实体和属性
    // 复合主键连接（粗线）
    SupplementRecord -- supplement_id [penwidth=3, color="#d32f2f"];
    SupplementRecord -- prescription_id [penwidth=3, color="#d32f2f"];
    
    // 普通属性连接
    SupplementRecord -- record_type;
    SupplementRecord -- content;
    SupplementRecord -- doctor_id;
    SupplementRecord -- doctor_name;
    SupplementRecord -- created_at;
    SupplementRecord -- tx_id;
    
    // 添加注释
    label=<<br/><font point-size="14"><b>补充记录实体 E-R 图</b></font><br/>
    <font point-size="12">医疗信息管理系统 - 补充记录实体属性关系图（弱实体）</font><br/>
    <font point-size="10">包含8个属性：2个复合主键，6个普通属性</font>>;
    labelloc="t";
    fontname="SimHei";
}
