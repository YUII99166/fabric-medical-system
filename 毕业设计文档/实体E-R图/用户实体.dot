graph ER {
    // 图形设置
    rankdir=TB;
    splines=true;
    nodesep=1.2;
    ranksep=1.2;
    bgcolor="#FFFFFF";
    
    node [fontname="SimHei", fontsize=12];
    edge [fontname="SimHei", fontsize=10, color="#666666"];

    // 用户实体（矩形，蓝色）
    User [
        shape=box, 
        label="用户\nUser", 
        style=filled, 
        fillcolor="#e3f2fd", 
        color="#1976d2",
        width=2.0, 
        height=1.2,
        fontsize=16,
        fontcolor="#1976d2"
    ];

    // 主键属性（椭圆，红色边框，下划线）
    user_id [
        shape=ellipse, 
        label=<<u><b>用户ID</b></u>>, 
        style=filled, 
        fillcolor="#ffebee",
        color="#d32f2f",
        penwidth=3
    ];
    
    // 唯一键属性（椭圆，橙色边框，下划线）
    username [
        shape=ellipse, 
        label=<<u>用户名</u>>, 
        style=filled, 
        fillcolor="#e3f2fd",
        color="#f57c00",
        penwidth=3
    ];
    
    // 认证相关属性
    password [
        shape=ellipse, 
        label="密码", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    account_name [
        shape=ellipse, 
        label="账号名", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    // 角色权限属性
    role [
        shape=ellipse, 
        label="角色", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    // 组织归属属性
    organization [
        shape=ellipse, 
        label="组织MSPID", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    org_name [
        shape=ellipse, 
        label="组织名称", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#4caf50"
    ];
    
    // 医生专用属性
    department [
        shape=ellipse, 
        label="科室", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#ff9800"
    ];
    
    doctor_title [
        shape=ellipse, 
        label="医生职称", 
        style=filled, 
        fillcolor="#e8f5e8",
        color="#ff9800"
    ];
    
    // 个人信息属性
    age [
        shape=ellipse, 
        label="年龄", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    gender [
        shape=ellipse, 
        label="性别", 
        style=filled, 
        fillcolor="#f3e5f5",
        color="#9c27b0"
    ];
    
    // 系统属性
    created_at [
        shape=ellipse, 
        label="创建时间", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];
    
    updated_at [
        shape=ellipse, 
        label="更新时间", 
        style=filled, 
        fillcolor="#e1f5fe",
        color="#03a9f4"
    ];

    // 连接实体和属性
    // 主键连接（粗线）
    User -- user_id [penwidth=3, color="#d32f2f"];
    
    // 唯一键连接（粗线）
    User -- username [penwidth=3, color="#f57c00"];
    
    // 普通属性连接
    User -- password;
    User -- account_name;
    User -- role;
    User -- organization;
    User -- org_name;
    User -- department;
    User -- doctor_title;
    User -- age;
    User -- gender;
    User -- created_at;
    User -- updated_at;
    
    // 添加注释
    label=<<br/><font point-size="14"><b>用户实体 E-R 图</b></font><br/>
    <font point-size="12">医疗信息管理系统 - 用户实体属性关系图</font><br/>
    <font point-size="10">包含13个属性：1个主键，1个唯一键，11个普通属性</font>>;
    labelloc="t";
    fontname="SimHei";
}
