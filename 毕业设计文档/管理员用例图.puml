@startuml 管理员用例图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #000000
skinparam actorBorderThickness 2
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1.5
    ArrowColor #000000
}
skinparam arrow {
    Color #000000
    Thickness 1.5
}

left to right direction

actor 管理员

usecase "登录" as login
usecase "查看架构概览" as viewArchitecture
usecase "查看数据统计" as viewStats
usecase "用户管理功能" as userManagement
usecase "查看权限请求" as viewPermissionRequest

usecase "添加用户" as addUser
usecase "编辑用户" as editUser
usecase "删除用户" as deleteUser
usecase "查看用户列表" as viewUserList

管理员 --> login
管理员 --> viewArchitecture
管理员 --> viewStats
管理员 --> userManagement
管理员 --> viewPermissionRequest

userManagement ..> addUser : <<包含>>
userManagement ..> editUser : <<包含>>
userManagement ..> deleteUser : <<包含>>
userManagement ..> viewUserList : <<包含>>

@enduml