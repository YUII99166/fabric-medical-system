@startuml 医生用例图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #000000
skinparam actorBorderThickness 2
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1.5
}
skinparam arrow {
    Color #000000
    Thickness 1.5
}

left to right direction

actor 医生

usecase "登录注册" as login
usecase "创建病历" as createPrescription
usecase "查看病历" as viewPrescription
usecase "申请跨院授权" as requestAccess
usecase "添加补充记录" as addSupplement
usecase "搜索病人信息" as searchPatient

usecase "查看病历详情" as viewDetail
usecase "查看授权状态" as viewAccessStatus

医生 --> login
医生 --> createPrescription
医生 --> viewPrescription
医生 --> requestAccess
医生 --> addSupplement
医生 --> searchPatient

viewPrescription ..> viewDetail : <<包含>>
requestAccess ..> viewAccessStatus : <<包含>>

@enduml