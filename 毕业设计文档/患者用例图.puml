@startuml 患者用例图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #000000
skinparam actorBorderThickness 2
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1.5
}
skinparam arrow {
    Color #000000
    Thickness 1.5
}

left to right direction

actor 患者

rectangle "登录注册" as login
rectangle "查看病历详情" as viewDetail
rectangle "查看个人信息" as viewProfile
rectangle "申请授权访问" as requestAccess
rectangle "查看药品订单" as viewOrder
rectangle "访问记录溯源" as accessTrace

rectangle "查看健康档案" as viewHealthProfile
rectangle "批准授权" as approveAccess

患者 --> login
患者 --> viewDetail
患者 --> viewProfile
患者 --> requestAccess
患者 --> viewOrder
患者 --> accessTrace

viewProfile ..> viewHealthProfile : <<包含>>
requestAccess ..> approveAccess : <<包含>>

@enduml